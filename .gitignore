# EDA tool and synthesis artifacts
*.bit
*.bin
*.mcs
*.prm
*.log
*.jou
*.backup.jou
*.backup.log
*.vcd
*.fst
*.ghw
*.cf
*.dSYM
*.gdb*

# Ignore temporary build folders but explicitly keep Basys 3 verified bitstreams
sw/basys/build/*
!sw/basys/build/neorv32_basys3.bit
!sw/basys/build/neorv32_basys3.bin

# Keep default VHDL memory images
!rtl/core/*_image.vhd

# Track Vivado / TCL automation scripts
!sw/basys/*.tcl
!rtl/**/*.tcl
